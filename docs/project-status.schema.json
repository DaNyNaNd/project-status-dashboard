{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/DaNyNaNd/project-status-dashboard/blob/main/docs/project-status.schema.json",
  "title": "Project Status Tracker",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "name",
    "status",
    "reviewed",
    "roadmap"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "in-progress",
        "planned",
        "paused",
        "complete",
        "archived"
      ]
    },
    "reviewed": {
      "type": "boolean",
      "description": "True after a human has confirmed the roadmap data."
    },
    "roadmap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "currentStage",
        "stages"
      ],
      "properties": {
        "outcome": {
          "type": "string",
          "minLength": 1,
          "description": "What will be achieved by the end of this roadmap."
        },
        "currentStage": {
          "type": "integer",
          "minimum": 1
        },
        "stages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "title"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "githubMilestone": {
                "type": "string",
                "minLength": 1,
                "description": "Optional GitHub milestone associated with this stage."
              }
            }
          }
        }
      }
    }
  }
}
