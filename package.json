{
  "name": "project-status-dashboard",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test": "node --test tests/project-status.test.mjs tests/agent-instructions.test.mjs",
    "agents:check": "node scripts/sync-agent-instructions.mjs",
    "agents:sync": "node scripts/sync-agent-instructions.mjs --write",
    "trackers:check": "node scripts/init-trackers.mjs",
    "trackers:init": "node scripts/init-trackers.mjs --write",
    "trackers:refresh": "node scripts/init-trackers.mjs --refresh-unreviewed",
    "test:sites": "node --test tests/sites-worker.test.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fontsource/source-serif-4": "^5.2.8",
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.2.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "8.1.5"
  },
  "devDependencies": {}
}
